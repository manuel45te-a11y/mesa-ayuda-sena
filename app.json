{
  "expo": {
    "name": "Mesa de Ayuda",
    "slug": "mesa-ayuda",
    "scheme": "mesaayuda",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F14",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mesaayuda.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#0B0F14"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos para adjuntar evidencias de las reparaciones.",
          "cameraPermission": "La app usa la cámara para fotografiar las evidencias de las reparaciones."
        }
      ]
    ]
  }
}
