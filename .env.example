# Copia este archivo como .env y pega tus credenciales de Supabase
# (Supabase -> Project Settings -> Data API / API Keys)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- La organización que usa la mesa de ayuda (todo esto es opcional) ---

# Nombre que se muestra en la app. Si se deja vacío solo se ve "Mesa de Ayuda".
EXPO_PUBLIC_ORGANIZACION=

# Tipo de organización: define cómo se llaman los lugares donde ocurren las
# fallas y qué datos se piden al registrarse.
#   empresa     Ubicaciones · área o dependencia y cargo   (por defecto)
#   educacion   Espacios    · programa o curso y grupo
#   salud       Áreas       · servicio y cargo
#   hotel       Ubicaciones · departamento y cargo
EXPO_PUBLIC_TIPO_ORGANIZACION=empresa

# Color de la app: indigo (por defecto), azul, violeta o turquesa.
EXPO_PUBLIC_COLOR=indigo

# Logo propio: dirección de una imagen cuadrada (png o jpg). Si se deja vacío
# se usa el símbolo de la app.
EXPO_PUBLIC_LOGO_URL=
